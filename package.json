{
  "name": "distribution-studio",
  "productName": "分发工作台",
  "version": "0.2.3",
  "private": true,
  "description": "本地优先的多平台图文分发客户端",
  "author": "gallonyin <gallonyin@gmail.com>",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && node scripts/build.mjs && vite build",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "pack": "npm run build && electron-builder --dir",
    "dist:mac": "npm run build && electron-builder --mac zip",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "accounts:check": "node scripts/check-accounts.mjs"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "lucide-react": "0.468.0",
    "marked": "15.0.12",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sanitize-html": "2.17.7",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "22.15.30",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@types/sanitize-html": "2.16.0",
    "@vitejs/plugin-react": "4.5.2",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.25.12",
    "prettier": "3.5.3",
    "typescript": "5.8.3",
    "vite": "6.4.3",
    "vitest": "3.2.7"
  },
  "build": {
    "appId": "local.distribution.studio",
    "productName": "分发工作台",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "THIRD_PARTY_NOTICES.md",
      "LICENSE"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "zip"
      ],
      "icon": "build/icon.icns",
      "identity": null
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "artifactName": "DistributionStudio-${version}-${os}-${arch}.${ext}"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gallonyin/distribution-studio.git"
  },
  "homepage": "https://github.com/gallonyin/distribution-studio#readme",
  "bugs": {
    "url": "https://github.com/gallonyin/distribution-studio/issues"
  }
}
